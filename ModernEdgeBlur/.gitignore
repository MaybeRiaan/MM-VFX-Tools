.aider*
# Build directories
build/
out/
bin/
obj/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt

# Compiled files
*.aex
*.dll
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# OS files
.DS_Store
Thumbs.db

# No vendored SDK here: the AE SDK comes from the shared AE_SDK_ROOT install
# (see README). Nothing needs restoring by hand for this project. The kept
# sdk/ rule is a guard only - an SDK must never be committed.
sdk/

# Distributable builds — committed for remote testing.
# Overrides the *.aex / *.exe ignores above for this directory only.
!dist/
!dist/*.aex
