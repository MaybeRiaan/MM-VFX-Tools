.aider*
# Build directories
build/
out/
bin/
obj/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt

# Compiled files
*.aex
*.dll
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# OS files
.DS_Store
Thumbs.db

# SDKs are never committed (license prohibits redistribution). The AE SDK now
# comes from the shared AE_SDK_ROOT install; only the optional Premiere SDK
# subset is still vendored here, under sdk/Premiere/.
sdk/

# Distributable builds — committed for remote testing.
# Overrides the *.aex / *.exe ignores above for this directory only.
!dist/
!dist/*.aex
