.aider*
# Build directories
build/
out/
bin/
obj/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.user

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
*.cmake
!CMakeLists.txt

# Compiled files
*.aex
*.dll
*.exe
*.obj
*.pdb
*.ilk
*.exp
*.lib

# OS files
.DS_Store
Thumbs.db

# SDKs are never committed (license prohibits redistribution). The AE SDK comes
# from the shared AE_SDK_ROOT install; the PREMIERE SDK has no shared install
# and is vendored here under sdk/Premiere/ for the optional, default-OFF
# EDGEREPAIR_PREMIERE_GPU module.
sdk/

# Test scratch
tests/out/

# Distributable builds — committed for remote testing.
# Overrides the *.aex ignores above for this directory only.
!dist/
!dist/*.aex
