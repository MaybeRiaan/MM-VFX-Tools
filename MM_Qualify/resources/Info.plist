<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for the macOS MM_FreqSep.plugin bundle. AE loads effect plugins
  as bundles whose package type is 'eFKT' and whose Resources hold the
  Rez-compiled PiPL (see CMakeLists.txt APPLE branch). Cannot be built or
  verified on the Windows dev machine; present so a Mac build is self-contained.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleExecutable</key>
    <string>MM_FreqSep</string>
    <key>CFBundleIdentifier</key>
    <string>com.mm.MM-FreqSep</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Skin Retouch</string>
    <key>CFBundlePackageType</key>
    <string>eFKT</string>
    <key>CFBundleSignature</key>
    <string>FXTC</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
</dict>
</plist>
